#!/bin/zsh
# Pre-commit hook:
# 1. Runs clearmeta.sh on all staged files (NUCLEAR metadata strip)
# 2. Checks committer is an allowed GitHub user (not email-based — emails change)

setopt pipefail 2>/dev/null || true
set -eo pipefail

ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"
CONFIG="$ROOT/repo.config.json"
CLEARMETA="$ROOT/.github/scripts/clearmeta.sh"

# ============================================
# STEP 1: NUCLEAR metadata strip on staged files
# ============================================

if [[ -x "$CLEARMETA" ]]; then
    staged_files=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null)
    
    if [[ -n "$staged_files" ]]; then
        echo "$staged_files" | while IFS= read -r file; do
            [[ ! -f "$file" ]] && continue
            [[ "$file" == ".git/"* ]] && continue
            "$CLEARMETA" -q "$file" 2>/dev/null || true
            git add "$file" 2>/dev/null
        done
        echo "[pre-commit] 🔥 NUKED metadata from staged files"
    fi
else
    echo "[pre-commit] warning: clearmeta.sh not found at $CLEARMETA"
fi

# ============================================
# STEP 2: GitHub user allowlist check
# ============================================

# Read allowed users from config (or fall back to repo owner)
if [[ -f "$CONFIG" ]] && command -v jq &>/dev/null; then
    ALLOWED=$(/usr/bin/jq -r '.allowed_github_users[]? // empty' "$CONFIG" 2>/dev/null)
    # Fallback: use owner.github_username if allowed_github_users not set
    if [[ -z "$ALLOWED" ]]; then
        ALLOWED=$(/usr/bin/jq -r '.owner.github_username // empty' "$CONFIG" 2>/dev/null)
    fi
fi

# If no allowlist configured, skip check
[[ -z "$ALLOWED" ]] && exit 0

# Check git user.name against allowed GitHub usernames
USERNAME=$(git config user.name 2>/dev/null || echo "")
[[ -z "$USERNAME" ]] && { echo "[pre-commit] ❌ git user.name not set"; exit 1; }

echo "$ALLOWED" | grep -qix "$USERNAME" && exit 0

# Also check if remote URL contains any allowed user (repo owner check)
REMOTE_URL=$(git config --get remote.origin.url 2>/dev/null || echo "")
for user in $(echo "$ALLOWED"); do
    [[ "$REMOTE_URL" == *"$user"* ]] && exit 0
done

echo ""
echo "╔══════════════════════════════════════════════════════════════╗"
echo "║  ❌ COMMIT BLOCKED - user not in allowed_github_users        ║"
echo "╠══════════════════════════════════════════════════════════════╣"
echo "║  Current user.name: $USERNAME"
echo "║  Allowed:           $(echo "$ALLOWED" | tr '\n' ', ' | sed 's/, $//')"
echo "╠══════════════════════════════════════════════════════════════╣"
echo "║  FIX: git config user.name '<github_username>'               ║"
echo "╚══════════════════════════════════════════════════════════════╝"
echo ""
exit 1
