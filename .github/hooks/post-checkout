#!/bin/bash
# Auto-check git identity on checkout
# Warns if user.name doesn't match allowed_github_users

ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"
CONFIG="$ROOT/repo.config.json"
USERNAME=$(git config user.name 2>/dev/null || echo "")

# Read allowed users from config
if [[ -f "$CONFIG" ]] && command -v jq &>/dev/null; then
    ALLOWED=$(jq -r '.allowed_github_users[]? // empty' "$CONFIG" 2>/dev/null)
    # Fallback: use owner.github_username if allowed_github_users not set
    if [[ -z "$ALLOWED" ]]; then
        ALLOWED=$(jq -r '.owner.github_username // empty' "$CONFIG" 2>/dev/null)
    fi
fi

[[ -z "$ALLOWED" ]] && exit 0
[[ -z "$USERNAME" ]] && { echo "⚠ git user.name not set"; exit 0; }

echo "$ALLOWED" | grep -qix "$USERNAME" && exit 0

echo ""
echo "⚠ Git user.name doesn't match allowed GitHub users for this repo."
echo ""
echo "Current: $USERNAME"
echo ""
echo "Allowed:"
echo "$ALLOWED" | sed 's/^/  /'
echo ""
echo "Fix: git config user.name '<github_username>'"
echo ""
